{
  "name": "Youtube Short Enhancer",
  "description": "Enhances the Youtube Shorts experience by adding useful features.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": "popup/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/shorts/*"],
      "js": ["scripts/shorts.js"]
    }
  ]
}